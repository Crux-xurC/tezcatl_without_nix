#!/bin/sh
# rel/env.sh.eex -- read by the release's start script. This repository's own.
#
# No Erlang distribution. Mix's default is RELEASE_DISTRIBUTION=sname, and with
# it `start` runs epmd (:4369) and the distribution port on every interface,
# guarded only by the cookie in releases/COOKIE -- which the tarball carries
# for anyone to read. Everything here listens on 127.0.0.1 only, and nothing
# uses `remote` or `rpc`.
export RELEASE_DISTRIBUTION=none
