{
  "autostart": true,
  "servers": {
    "javascript": {
      "command": ["typescript-language-server", "--stdio"],
      "rootMarkers": ["tsconfig.json", "jsconfig.json", "package.json", ".git"]
    },
    "json": {
      "command": ["vscode-json-language-server", "--stdio"],
      "rootMarkers": ["package.json", ".git"]
    },
    "css": {
      "command": ["vscode-css-language-server", "--stdio"],
      "rootMarkers": ["package.json", ".git"]
    },
    "html": {
      "command": ["vscode-html-language-server", "--stdio"],
      "rootMarkers": ["package.json", ".git"]
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "rootMarkers": [".git"]
    },
    "markdown": {
      "command": ["marksman", "server"],
      "rootMarkers": [".marksman.toml", ".git"]
    },
    "python": {
      "command": ["pyright-langserver", "--stdio"],
      "rootMarkers": ["pyproject.toml", "setup.py", "setup.cfg", "requirements.txt", "Pipfile", ".git"]
    },
    "rust": {
      "command": ["rust-analyzer"],
      "rootMarkers": ["Cargo.toml", "rust-project.json", ".git"]
    },
    "shell": {
      "command": ["tezcatl-shell-lsp"],
      "rootMarkers": [".git"]
    },
    "lua": {
      "command": ["lua-language-server"],
      "rootMarkers": [".luarc.json", ".luarc.jsonc", ".git"]
    },
    "sql": {
      "command": ["sql-language-server", "up", "--method", "stdio"],
      "rootMarkers": [".sqllsrc.json", ".git"]
    },
    "dockerfile": {
      "command": ["docker-langserver", "--stdio"],
      "rootMarkers": ["Dockerfile", ".git"]
    },
    "elixir": {
      "command": ["elixir-ls"],
      "rootMarkers": ["mix.exs", ".git"],
      "editor": { "command": ["tezcatl-elixir-lsp"] }
    },
    "nix": {
      "command": ["nil"],
      "rootMarkers": ["flake.nix", "default.nix", "shell.nix", ".git"]
    },
    "ocaml": {
      "command": ["ocamllsp"],
      "rootMarkers": ["dune-project", "dune-workspace", ".git"]
    },
    "haskell": {
      "command": ["tezcatl-haskell-lsp"],
      "rootMarkers": ["cabal.project", "stack.yaml", "package.yaml", ".git"]
    }
  }
}
